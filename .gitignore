# Generated data and builds
/data/samples/
/data/real/
# Fetched GIS bundles: the payload is downloadable, the manifest is the record.
/data/*/*.geojson
!/data/*/manifest.json
*.laz
*.las
*.part
/build/
/viewer/world/
*.lwir
*.city.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Node (viewer dev tooling only)
node_modules/
package-lock.json

# Local scratch
shot.mjs
probe.mjs
*.png
!docs/img/*.png

# Acquired GIS vectors: reproducible from data/acquire.py in ~90s, and the
# tree-canopy neighbourhood polygons alone are 31 MB. The provenance sidecars
# and manifest are kept -- they are the record of what was fetched, and carry
# the sha256 to check a refetch against.
/data/gis/**/*.geojson
/data/real/extents_*.json
/data/real/download.log

# DRAPP orthophoto: 446 MB a tile, nine of them over one AOI. Reproducible from
# data/imagery/tiles.json, which carries the index and is kept.
/data/imagery/*.tif
/data/imagery/*.tfw
/data/imagery/download.log

# Vienna Kappazunder test archives: CC BY 4.0 and directly downloadable from
# wien.gv.at, so reproducible rather than vendored. URLs in data/vienna.py.
/data/vienna/*.zip
/data/vienna/extracted/

# Hamburg LoD3.0-HH tiles: dl-de/by-2-0 and directly downloadable from
# daten-hamburg.de, so reproducible rather than vendored. One inner-city tile is
# 199 MB. URLs and per-tile extraction in data/hamburg.py.
/data/hamburg/

# Helsinki 3D+ mesh and semantic model: CC BY 4.0 and directly downloadable
# from 3d.hel.ninja, so reproducible rather than vendored. The whole reality
# mesh is 190 GB over 122 tiles; the nine central tiles are 13.3 GB and one
# unpacks to thousands of OBJ/MTL/JPEG files. URLs in data/helsinki.py.
/data/helsinki/
