{
 "id": "neon",
 "name": "Neon Sprawl",
 "era": "2140",
 "description": "Same scan, same geometry, 250 years later. Street-facing walls become lit signage, corners get structural cladding, openings glow, and the carriageway is permanently wet.",
 "author": "lidarworld",
 "license": "CC0-1.0",
 "fallback": "default",
 "environment": {
  "sky": [0.03, 0.04, 0.09],
  "horizon": [0.16, 0.06, 0.24],
  "fog": [0.07, 0.06, 0.14],
  "fogDensity": 0.022,
  "sunDirection": [-0.4, 0.35, -0.6],
  "sunColor": [0.55, 0.60, 1.0],
  "ambient": [0.16, 0.14, 0.28],
  "exposure": 1.25
 },
 "materials": [
  {"id": "default", "generator": "concrete", "baseColor": [0.22, 0.23, 0.27], "roughness": 0.8, "scale": 2.0},
  {"id": "clad_panel", "generator": "metal_panel", "baseColor": [0.26, 0.28, 0.34], "params": {"cols": 5, "rows": 7}, "roughness": 0.42, "metallic": 0.6, "scale": 2.2, "tags": ["wall"]},
  {"id": "clad_corner", "generator": "metal_panel", "baseColor": [0.42, 0.45, 0.52], "params": {"cols": 2, "rows": 3}, "roughness": 0.3, "metallic": 0.8, "scale": 1.4, "tags": ["wall", "corner"]},
  {"id": "signage_cyan", "generator": "neon_panel", "baseColor": [0.05, 0.06, 0.10], "params": {"accent": [0.10, 0.95, 0.90], "cols": 6, "rows": 9}, "emissive": [0.10, 0.85, 0.80], "roughness": 0.3, "scale": 2.6, "tags": ["signage", "street"]},
  {"id": "signage_magenta", "generator": "neon_panel", "baseColor": [0.07, 0.04, 0.09], "params": {"accent": [0.95, 0.15, 0.65], "cols": 5, "rows": 7}, "emissive": [0.85, 0.12, 0.58], "roughness": 0.3, "scale": 2.2, "tags": ["signage", "opening"]},
  {"id": "rust_deck", "generator": "metal_panel", "baseColor": [0.30, 0.26, 0.24], "params": {"cols": 3, "rows": 3, "rust": 0.75}, "roughness": 0.85, "metallic": 0.25, "scale": 3.0, "tags": ["roof"]},
  {"id": "solar_deck", "generator": "neon_panel", "baseColor": [0.04, 0.05, 0.09], "params": {"accent": [0.12, 0.20, 0.42], "cols": 8, "rows": 8}, "roughness": 0.25, "metallic": 0.4, "scale": 3.0, "tags": ["roof"]},
  {"id": "smart_glass", "generator": "glass", "baseColor": [0.10, 0.28, 0.36], "emissive": [0.08, 0.42, 0.50], "roughness": 0.06, "opacity": 0.45, "scale": 1.4, "tags": ["glazing"]},
  {"id": "blast_door", "generator": "metal_panel", "baseColor": [0.16, 0.17, 0.20], "params": {"cols": 2, "rows": 4}, "roughness": 0.5, "metallic": 0.7, "scale": 1.0, "tags": ["door"]},
  {"id": "wet_asphalt", "generator": "asphalt", "baseColor": [0.10, 0.11, 0.14], "roughness": 0.22, "metallic": 0.1, "scale": 4.0, "tags": ["road"]},
  {"id": "light_strip", "generator": "neon_panel", "baseColor": [0.05, 0.05, 0.07], "params": {"accent": [0.95, 0.75, 0.20], "cols": 2, "rows": 20}, "emissive": [0.90, 0.65, 0.15], "roughness": 0.3, "scale": 1.6, "tags": ["kerb"]},
  {"id": "dead_ground", "generator": "gravel", "baseColor": [0.20, 0.20, 0.22], "roughness": 0.95, "scale": 3.0, "tags": ["ground"]},
  {"id": "coolant_pool", "generator": "water", "baseColor": [0.05, 0.30, 0.28], "emissive": [0.02, 0.18, 0.16], "roughness": 0.08, "scale": 5.0, "tags": ["water"]},
  {"id": "bio_canopy", "generator": "foliage", "baseColor": [0.10, 0.32, 0.26], "emissive": [0.02, 0.10, 0.08], "roughness": 0.8, "scale": 2.0, "tags": ["vegetation"]},
  {"id": "pylon", "generator": "metal_panel", "baseColor": [0.18, 0.19, 0.22], "params": {"cols": 1, "rows": 6, "rust": 0.2}, "roughness": 0.45, "metallic": 0.7, "scale": 1.0, "tags": ["pole"]},
  {"id": "hover_shell", "generator": "metal_panel", "baseColor": [0.32, 0.34, 0.44], "params": {"cols": 2, "rows": 2}, "roughness": 0.25, "metallic": 0.8, "scale": 1.0, "tags": ["vehicle"]}
 ],
 "rules": [
  {"material": "signage_magenta", "role": "surface.wall", "ctx_all": ["opening_boundary"], "priority": 4, "note": "light spill framing every opening"},
  {"material": "clad_corner", "role": "surface.wall", "ctx_any": ["corner_convex", "corner_concave"], "priority": 3, "note": "structural cladding on corners"},
  {"material": "signage_cyan", "role": "surface.wall", "ctx_all": ["street_facing"], "ctx_none": ["ground_contact"], "priority": 2, "note": "everything the street can see becomes advertising"},
  {"material": "light_strip", "role": "surface.wall", "ctx_all": ["ground_contact"], "priority": 2},
  {"material": "clad_corner", "role": "surface.wall", "ctx_all": ["top"], "priority": 1},
  {"material": "clad_panel", "role": "surface.wall"},
  {"material": "solar_deck", "role": "surface.roof.flat"},
  {"material": "rust_deck", "role": "surface.roof"},
  {"material": "clad_panel", "role": "surface.slab"},
  {"material": "clad_corner", "role": "edge"},
  {"material": "clad_corner", "role": "corner"},
  {"material": "smart_glass", "role": "opening.window"},
  {"material": "blast_door", "role": "opening.door"},
  {"material": "smart_glass", "role": "opening"},
  {"material": "light_strip", "role": "terrain.road", "ctx_any": ["edge_u_min", "edge_u_max", "edge_v_min", "edge_v_max"], "priority": 2},
  {"material": "wet_asphalt", "role": "terrain.road"},
  {"material": "coolant_pool", "role": "terrain.water"},
  {"material": "dead_ground", "role": "terrain.ground"},
  {"material": "wet_asphalt", "role": "terrain"},
  {"material": "bio_canopy", "role": "volume.vegetation"},
  {"material": "pylon", "role": "linear"},
  {"material": "hover_shell", "role": "instance.vehicle"},
  {"material": "pylon", "role": "instance"},
  {"material": "default", "role": "*"}
 ]
}
