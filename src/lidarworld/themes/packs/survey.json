{
 "id": "survey",
 "name": "Survey Analytic",
 "era": "diagnostic",
 "description": "Not a look -- an instrument. Flat colour per role with the context flags called out, so you can see exactly what the compiler decided before you dress it up. Corners, opening surrounds, ground contact and inferred (never-observed) geometry each get their own colour.",
 "author": "lidarworld",
 "license": "CC0-1.0",
 "fallback": "default",
 "environment": {
  "sky": [0.09, 0.10, 0.12],
  "horizon": [0.14, 0.16, 0.19],
  "fog": [0.10, 0.11, 0.13],
  "fogDensity": 0.004,
  "sunDirection": [0.3, 0.8, 0.5],
  "sunColor": [1.0, 1.0, 1.0],
  "ambient": [0.55, 0.57, 0.60],
  "exposure": 1.0
 },
 "materials": [
  {"id": "default", "generator": "concrete", "baseColor": [0.35, 0.35, 0.38], "roughness": 1.0, "scale": 2.0},
  {"id": "wall_face", "generator": "plaster", "baseColor": [0.30, 0.55, 0.72], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 2.0, "tags": ["diagnostic"]},
  {"id": "wall_corner", "generator": "plaster", "baseColor": [1.00, 0.78, 0.20], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 1.0, "tags": ["diagnostic", "corner"]},
  {"id": "wall_opening_edge", "generator": "plaster", "baseColor": [0.95, 0.35, 0.45], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 1.0, "tags": ["diagnostic", "opening"]},
  {"id": "wall_near_opening", "generator": "plaster", "baseColor": [0.72, 0.35, 0.60], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 1.0, "tags": ["diagnostic"]},
  {"id": "wall_ground", "generator": "plaster", "baseColor": [0.55, 0.45, 0.25], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 1.0, "tags": ["diagnostic"]},
  {"id": "wall_inferred", "generator": "plaster", "baseColor": [0.45, 0.20, 0.55], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 1.0, "tags": ["diagnostic", "low-confidence"]},
  {"id": "roof_face", "generator": "plaster", "baseColor": [0.85, 0.45, 0.25], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 2.0, "tags": ["diagnostic"]},
  {"id": "slab_face", "generator": "plaster", "baseColor": [0.60, 0.60, 0.65], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 2.0},
  {"id": "road_face", "generator": "plaster", "baseColor": [0.22, 0.22, 0.26], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 4.0},
  {"id": "road_edge", "generator": "plaster", "baseColor": [0.95, 0.85, 0.30], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 1.0},
  {"id": "ground_face", "generator": "plaster", "baseColor": [0.35, 0.50, 0.30], "params": {"wear": 0.0}, "roughness": 1.0, "scale": 4.0},
  {"id": "water_face", "generator": "water", "baseColor": [0.15, 0.35, 0.55], "roughness": 0.2, "scale": 6.0},
  {"id": "glass_face", "generator": "glass", "baseColor": [0.20, 0.75, 0.85], "opacity": 0.4, "roughness": 0.1, "scale": 1.0},
  {"id": "veg_face", "generator": "foliage", "baseColor": [0.25, 0.65, 0.30], "roughness": 1.0, "scale": 2.0},
  {"id": "linear_face", "generator": "metal_panel", "baseColor": [0.80, 0.80, 0.85], "params": {"cols": 1, "rows": 4}, "roughness": 0.6, "metallic": 0.4, "scale": 1.0},
  {"id": "instance_face", "generator": "metal_panel", "baseColor": [0.45, 0.55, 0.85], "params": {"cols": 2, "rows": 2}, "roughness": 0.5, "scale": 1.0}
 ],
 "rules": [
  {"material": "wall_inferred", "role": "surface", "ctx_any": ["sparse_evidence", "occluded"], "priority": 5, "note": "geometry the sensor never actually saw"},
  {"material": "wall_opening_edge", "role": "surface.wall", "ctx_all": ["opening_boundary"], "priority": 4},
  {"material": "wall_corner", "role": "surface.wall", "ctx_any": ["corner_convex", "corner_concave"], "priority": 3},
  {"material": "wall_near_opening", "role": "surface.wall", "ctx_all": ["near_opening"], "priority": 2},
  {"material": "wall_ground", "role": "surface.wall", "ctx_any": ["ground_contact", "bottom"], "priority": 1},
  {"material": "wall_face", "role": "surface.wall"},
  {"material": "roof_face", "role": "surface.roof"},
  {"material": "slab_face", "role": "surface.slab"},
  {"material": "wall_corner", "role": "edge"},
  {"material": "wall_corner", "role": "corner"},
  {"material": "glass_face", "role": "opening"},
  {"material": "road_edge", "role": "terrain.road", "ctx_any": ["edge_u_min", "edge_u_max", "edge_v_min", "edge_v_max"], "priority": 2},
  {"material": "road_face", "role": "terrain.road"},
  {"material": "water_face", "role": "terrain.water"},
  {"material": "ground_face", "role": "terrain.ground"},
  {"material": "ground_face", "role": "terrain"},
  {"material": "veg_face", "role": "volume.vegetation"},
  {"material": "linear_face", "role": "linear"},
  {"material": "instance_face", "role": "instance"},
  {"material": "default", "role": "*"}
 ]
}
